{
  "sourceLanguage": "en",
  "strings": {
    "sidebar.custom.runtime.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar runtime support is missing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーランタイムが見つかりません。"
          }
        }
      }
    },
    "sidebar.custom.runtime.noView": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sidebar did not create a view."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイドバーはビューを作成しませんでした。"
          }
        }
      }
    },
    "sidebar.custom.runtime.resourceLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sidebar exceeded its resource limit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイドバーはリソース制限を超えました。"
          }
        }
      }
    },
    "sidebar.custom.runtime.scriptFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar script failed. Check the sidebar source."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバースクリプトに失敗しました。ソースを確認してください。"
          }
        }
      }
    },
    "sidebar.custom.runtime.scriptFailedLine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar script failed near line %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバースクリプトが%d行付近で失敗しました。"
          }
